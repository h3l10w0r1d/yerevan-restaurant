# Database (SQLite file by default; use Postgres in production)
DATABASE_URL=sqlite:///./yerevan.db
# First owner account, created on startup when no users exist
ADMIN_EMAIL=admin@yerevanrestaurant.nl
ADMIN_PASSWORD=change-me
ADMIN_NAME=Owner
# Email via Resend (leave empty to only log emails)
RESEND_API_KEY=
EMAIL_FROM=Yerevan Restaurant <reserveringen@yerevanrestaurant.nl>
SITE_URL=http://localhost:5185
